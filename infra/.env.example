# Muamalat local development environment.
#
#   cp infra/.env.example infra/.env
#
# Docker Compose reads infra/.env automatically because the project directory is the
# directory holding the compose file. Every value below is a DEVELOPMENT default and is
# safe to commit as an example. infra/.env itself is git-ignored and must never contain a
# credential that is also used anywhere real.


# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=muamalat
POSTGRES_USER=muamalat

# Required. Compose refuses to start if this is unset, rather than silently booting a
# database with an empty password.
POSTGRES_PASSWORD=muamalat_local_dev

# Host port for psql / a GUI client. Change it if 5432 is already taken by a local
# PostgreSQL install; nothing inside the compose network uses this value.
POSTGRES_PORT=5432


# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
# Bootstrap admin for the Keycloak master realm (the admin console at
# http://localhost:8081/admin). This is not an application user.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Host port for Keycloak.
KEYCLOAK_PORT=8081

# The URL that BROWSERS use to reach Keycloak. Keycloak stamps this into the `iss` claim
# of every token it issues.
#
# If you change KEYCLOAK_PORT you must change the port here too, and you must add the new
# origin to the SPA client's redirect URIs in infra/keycloak/realm-muamalat.json.
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# The URL the API container uses to reach Keycloak for OIDC discovery and JWKS. It is a
# service name, not localhost, because "localhost" inside the API container is the API.
#
# These two being different is not a mistake. Keycloak runs with
# KC_HOSTNAME_BACKCHANNEL_DYNAMIC, so a discovery request arriving here still reports the
# PUBLIC issuer (matching the token) while handing back endpoint URLs the API can actually
# reach. See docs/ARCHITECTURE.md section 2.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

KEYCLOAK_REALM=muamalat

# OIDC client the Angular SPA uses. Public client, authorization code + PKCE, no secret.
KEYCLOAK_WEB_CLIENT_ID=muamalat-web

# The API's client id. This doubles as the expected `aud` claim on incoming access tokens.
KEYCLOAK_API_CLIENT_ID=muamalat-api

# Confidential secret for the API client. Only needed if the API calls Keycloak's admin or
# introspection endpoints; plain JWT bearer validation does not use it. This value is also
# hardcoded in the committed realm export, so it is a development placeholder by
# definition. Rotate it (in both places) before this stack is exposed to anything.
KEYCLOAK_API_CLIENT_SECRET=dev-only-not-a-real-secret


# ---------------------------------------------------------------------------
# API (ASP.NET Core)
# ---------------------------------------------------------------------------
# Host port for the API. The container always listens on 8080 internally.
API_PORT=8080

# Development turns on the OpenAPI document and detailed error pages.
#
# It is also the ONLY environment in which the API will accept plaintext OIDC metadata:
# its options validator rejects Authentication:AllowHttpMetadata outside Development, so
# changing this to Production without also putting Keycloak behind TLS fails at startup.
# That is intended.
ASPNETCORE_ENVIRONMENT=Development

# Serilog minimum level: Verbose | Debug | Information | Warning | Error | Fatal
LOG_LEVEL=Information

# Maximum size of a single uploaded supporting document, in bytes (default 10 MiB).
# Keep this at or below nginx's client_max_body_size in infra/nginx.conf (20 MiB), or
# large uploads are rejected by the proxy before the API ever sees them.
MAX_DOCUMENT_BYTES=10485760

# Background sweep that flags at-risk and breached SLAs and raises escalations.
# Disable it if you want deterministic timing while debugging.
SLA_SWEEP_ENABLED=true
SLA_SWEEP_INTERVAL_SECONDS=60


# ---------------------------------------------------------------------------
# Web (Angular behind nginx)
# ---------------------------------------------------------------------------
# Host port for the SPA. The container always listens on 8080 internally (unprivileged).
WEB_PORT=4200

# Substituted into the nginx Content-Security-Policy at container start. The browser needs
# to reach Keycloak directly for the authorization code redirect and the token exchange,
# so this origin must be allowed in connect-src and frame-src. Keep it in sync with
# KEYCLOAK_PUBLIC_URL.
WEB_KEYCLOAK_ORIGIN=http://localhost:8081

# Where nginx forwards /api/* . Service name and container port, not the host port.
WEB_API_UPSTREAM=http://api:8080
