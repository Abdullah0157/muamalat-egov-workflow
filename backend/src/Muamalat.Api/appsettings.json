{
  "ConnectionStrings": {
    "Muamalat": ""
  },
  "Authentication": {
    "Authority": "",
    "Audience": "muamalat-api",
    "AllowHttpMetadata": false,
    "ClockSkewSeconds": 30
  },
  "Storage": {
    "DocumentRoot": "/var/lib/muamalat/documents",
    "MaxDocumentBytes": 10485760,
    "AllowedContentTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png"
    ]
  },
  "SlaSweep": {
    "Enabled": true,
    "IntervalSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "Application": "Muamalat.Api"
    }
  },
  "AllowedHosts": "*"
}
